{
  "name": "@plantilla/api-gateway",
  "version": "1.0.0",
  "description": "Punto de entrada único: enrutamiento por prefijo, validación temprana de JWT, rate limiting, correlation ID y bloqueo de rutas internas.",
  "private": true,
  "main": "src/server.js",
  "imports": {
    "#config/*": "./src/config/*.js",
    "#routing/*": "./src/routing/*.js",
    "#middlewares/*": "./src/middlewares/*.js"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "cross-env NODE_ENV=test jest --passWithNoTests",
    "test:coverage": "cross-env NODE_ENV=test jest --passWithNoTests --coverage"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "../../packages/shared/src"
    ],
    "ext": "js,json"
  },
  "dependencies": {
    "@plantilla/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "http-proxy-middleware": "^3.0.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4"
  },
  "license": "MIT"
}
