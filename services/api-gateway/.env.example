# ─── api-gateway ─────────────────────────────────────────────────────────────
NODE_ENV=development
SERVICE_NAME=api-gateway
PORT=4000
LOG_LEVEL=info
# Orígenes del front separados por coma (en producción NUNCA "*")
CORS_ORIGINS=http://localhost:3000

# Redis: lista de sesiones revocadas (logout inmediato) — opcional en dev
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

# El gateway no consume eventos; solo publica auditoría
EVENT_BUS_DRIVER=redis-streams
EVENT_STREAM_NAME=plantilla:events

# Solo la clave PÚBLICA
JWT_PUBLIC_KEY=
JWT_ISSUER=plantilla-iam
JWT_AUDIENCE=plantilla-api

INTERNAL_API_KEY=

# Servicios destino
IAM_SERVICE_URL=http://localhost:4001
PERSON_SERVICE_URL=http://localhost:4002
NOTIFICATION_SERVICE_URL=http://localhost:4003
AUDIT_SERVICE_URL=http://localhost:4004

PROXY_TIMEOUT_MS=15000
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
