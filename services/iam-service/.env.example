# ─── iam-service ─────────────────────────────────────────────────────────────
NODE_ENV=development
SERVICE_NAME=iam-service
PORT=4001
LOG_LEVEL=info
CORS_ORIGINS=*

# Base de datos (un Postgres, esquema propio)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plantilla
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=iam
DB_SSL=false

# Redis (opcional: sin Redis cae a memoria)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

# Eventos: memory | redis-streams | sns-sqs
EVENT_BUS_DRIVER=redis-streams
EVENT_STREAM_NAME=plantilla:events

# JWT RS256 — iam-service es el ÚNICO con la clave PRIVADA (pnpm keys:generate)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=plantilla-iam
JWT_AUDIENCE=plantilla-api
JWT_ACCESS_TOKEN_TTL=900

# PII (32 bytes hex) — pnpm keys:generate
AES_KEY=
HASH_PEPPER=

# Llamadas servicio → servicio (mismo valor en todos los servicios)
INTERNAL_API_KEY=

# Política de autenticación
BCRYPT_ROUNDS=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
SESSION_MAX_HOURS=8
SESSION_IDLE_MINUTES=30
WORKERS_ENABLED=true

# Seeder del admin inicial
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
