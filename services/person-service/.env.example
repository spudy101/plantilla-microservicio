# ─── person-service ──────────────────────────────────────────────────────────
NODE_ENV=development
SERVICE_NAME=person-service
PORT=4002
LOG_LEVEL=info
CORS_ORIGINS=*

DB_HOST=localhost
DB_PORT=5432
DB_NAME=plantilla
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=person
DB_SSL=false

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

EVENT_BUS_DRIVER=redis-streams
EVENT_STREAM_NAME=plantilla:events

# Solo la clave PÚBLICA: este servicio verifica tokens, no los emite
JWT_PUBLIC_KEY=
JWT_ISSUER=plantilla-iam
JWT_AUDIENCE=plantilla-api

# PII (puede ser distinta a la de iam: cada servicio cifra sus propios datos)
AES_KEY=
HASH_PEPPER=

INTERNAL_API_KEY=
