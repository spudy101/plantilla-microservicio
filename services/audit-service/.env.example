# ─── audit-service ──────────────────────────────────────────────────────────
NODE_ENV=development
SERVICE_NAME=audit-service
PORT=4004
LOG_LEVEL=info
CORS_ORIGINS=*

DB_HOST=localhost
DB_PORT=5432
DB_NAME=plantilla
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=audit
DB_SSL=false

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

EVENT_BUS_DRIVER=redis-streams
EVENT_STREAM_NAME=plantilla:events

# Solo la clave PÚBLICA: este servicio verifica tokens, no los emite
JWT_PUBLIC_KEY=
JWT_ISSUER=plantilla-iam
JWT_AUDIENCE=plantilla-api


INTERNAL_API_KEY=
