{
  "name": "@plantilla/audit-service",
  "version": "1.0.0",
  "description": "Auditoría centralizada append-only: persiste los audit.log.recorded de todos los servicios y expone la consulta para admin.",
  "private": true,
  "main": "src/server.js",
  "imports": {
    "#config/*": "./src/config/*.js",
    "#schemas": "./src/schemas/index.js",
    "#schemas/*": "./src/schemas/*.js",
    "#modules/*": "./src/modules/*.js",
    "#events/*": "./src/events/*.js"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "cross-env NODE_ENV=test jest --passWithNoTests",
    "test:coverage": "cross-env NODE_ENV=test jest --passWithNoTests --coverage",
    "db:migrate": "node scripts/ensure-schema.js && sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "../../packages/shared/src"
    ],
    "ext": "js,json"
  },
  "dependencies": {
    "@plantilla/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.3.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.4"
  },
  "license": "MIT"
}
