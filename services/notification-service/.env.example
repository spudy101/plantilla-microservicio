# ─── notification-service ────────────────────────────────────────────────────
NODE_ENV=development
SERVICE_NAME=notification-service
PORT=4003
LOG_LEVEL=info
CORS_ORIGINS=*

DB_HOST=localhost
DB_PORT=5432
DB_NAME=plantilla
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=notification
DB_SSL=false

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

EVENT_BUS_DRIVER=redis-streams
EVENT_STREAM_NAME=plantilla:events

JWT_PUBLIC_KEY=
JWT_ISSUER=plantilla-iam
JWT_AUDIENCE=plantilla-api

INTERNAL_API_KEY=
IAM_SERVICE_URL=http://localhost:4001

# console (solo loggea) | ses
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
AWS_REGION=us-east-1
